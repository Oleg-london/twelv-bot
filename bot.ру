import telebot
import os

bot = telebot.TeleBot(os.environ["TOKEN"])


@bot.message_handler(commands=['start'])
def send_welcome(message):
    # Получаем имя пользователя
    user_name = message.from_user.first_name
    
    # Текст приветствия
    welcome_text = (
        f"Привет, {user_name}! 👋\n\n"
        f"Добро пожаловать в *OneEighty* — команду фрилансеров.\n\n"
        f"*Чем я могу помочь:*\n"
        f"• Оставить заявку на проект\n"
        f"• Узнать наши услуги и цены\n"
        f"• Связаться с командой\n"
        f"• Посмотреть примеры работ\n\n"
        f"Нажми кнопку ниже, чтобы начать 👇"
    )
    
    # Кнопки
    keyboard = telebot.types.InlineKeyboardMarkup()
    keyboard.add(
        telebot.types.InlineKeyboardButton("📋 Услуги", callback_data="services"),
        telebot.types.InlineKeyboardButton("💰 Цены", callback_data="prices")
    )
    keyboard.add(
        telebot.types.InlineKeyboardButton("✍️ Оставить заявку", callback_data="order"),
        telebot.types.InlineKeyboardButton("📞 Связаться", callback_data="contact")
    )
    
    bot.send_message(message.chat.id, welcome_text, parse_mode='Markdown', reply_markup=keyboard)


# Обработка нажатий на кнопки
@bot.callback_query_handler(func=lambda call: True)
def handle_buttons(call):
    if call.data == "services":
        bot.send_message(call.message.chat.id, "🎨 *Наши услуги:*\n\n• Дизайн\n• Разработка\n• Маркетинг\n• Копирайтинг")
    elif call.data == "prices":
        bot.send_message(call.message.chat.id, "💰 *Цены:*\n\nОбсуждаются индивидуально. Оставьте заявку!")
    elif call.data == "order":
        bot.send_message(call.message.chat.id, "✍️ Напишите ваш запрос, и мы свяжемся с вами.")
    elif call.data == "contact":
        bot.send_message(call.message.chat.id, "📞 Связь:\n\nEmail: hello@twelv.com\nTelegram: @twelv_manager")
    
    bot.answer_callback_query(call.id)


bot.polling(none_stop=True)